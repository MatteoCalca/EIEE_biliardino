# Copy this file to ".streamlit/secrets.toml" (which is git-ignored) for local
# development against Supabase, OR paste the same [db] block into the
# "Secrets" box of your app on share.streamlit.io for production.
#
# Without any secret, the app falls back to a local SQLite file (local.db),
# which is perfect for offline development.

[db]
# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (URI form). It looks like:
url = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
